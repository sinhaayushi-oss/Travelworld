<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listing" novalidate class="needs-validation">
        <div>
            <label for="title" class = "form-label"><b>Title:</b></label>
            <input type="text" id="title" name="listing[title]" placeholder="Enter title" required class="form-control"><br>
            <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Please provide a title for the listing.
            </div>
        </div>
        <div>
            <label for="description" class = "form-label"><b>Description:</b></label>
            <textarea id="description" name="listing[description]" placeholder="Enter description" required class ="form-control"></textarea><br>
            <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Please provide a description for the listing.
            </div>
        </div>
         <div>
            <label for="image" class = "form-label"><b>Image URL:</b></label>
            <input
            type="text"
            name="listing[image][url]"
            placeholder="Enter image URL"
            class="form-control"><br><br>
        </div>
        <div class="row">
            <div class="mb-3 col-4">
                <label for="price" class = "form-label"><b>Price:</b></label>
                <input type="number" id="price" name="listing[price]" placeholder="Enter price" required><br>
                <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Please provide a price for the listing.
            </div>
            </div>
            <div class="mb-3 col-8">
                <label for="country" class = "form-label"><b>Country:</b></label>
                <input type="text" id="country" name="listing[country]" placeholder="Enter country" required class="form-control"><br>
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please provide a country for the listing.
                </div>
            </div>
        </div>
        <div>
            <label for="location" class = "form-label"><b>Location:</b></label>
            <input type="text" id="location" name="listing[location]" placeholder="Enter location" required class = "form-control"><br>
            <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Please provide a location for the listing.
            </div>
        </div>

        <button type="submit" class="btn btn-dark ">Add</button>

    </form>
</div>
</div>
